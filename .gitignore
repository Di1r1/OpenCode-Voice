# Local OpenCode runtime artifacts for the voice plugin.
# The synced plugin copy (.opencode/plugins/index.ts), tui/web, agents and commands
# are kept on disk only — regenerate the plugin copy with sync-plugin.sh.
# Exception: agent skills (.opencode/skills/) ARE versioned — they document the product.
voice-opencode-plugin/.opencode/*
!voice-opencode-plugin/.opencode/skills/
