# Local OpenCode runtime artifacts for the voice plugin.
# The synced plugin copy (.opencode/plugins/index.ts) is generated — run sync-plugin.sh.
# Versioned runtime assets: tui/web plugins and commands.
# .opencode/agents/ and .opencode/skills/ are local dev material — not versioned.
voice-opencode-plugin/.opencode/*
!voice-opencode-plugin/.opencode/tui/
!voice-opencode-plugin/.opencode/web/
!voice-opencode-plugin/.opencode/commands/

# Python/test caches (also keeps them out of the npm tarball)
__pycache__/
*.pyc
.pytest_cache/

# Internal dev docs / dead assets (kept locally, not published)
/AUDIT.md
voice-opencode-plugin/TEST_PLAN.md
voice-opencode-plugin/extension/README.md
voice-opencode-plugin/extension/icon.svg
voice-opencode-plugin/AGENTS.md
voice-opencode-plugin/SKILLS_GUIDE.md
