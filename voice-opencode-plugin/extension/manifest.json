{
  "manifest_version": 3,
  "name": "OpenCode Voice",
  "version": "1.0.3",
  "description": "Voice input for OpenCode web UI",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:*/*", "http://127.0.0.1:*/*", "http://172.16.0.0/12:*/*", "http://192.168.0.0/16:*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:*/*", "http://127.0.0.1:*/*", "<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenCode Voice"
  }
}