{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "opencode",
  "leader_timeout": 2000,
  "plugin": ["./.opencode/tui/voice.ts", "./.opencode/web/voice.ts"],
  "keybinds": {
    "leader": "ctrl+x"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.6,
    "sound_pack": "opencode.default"
  }
}